[Unit]
Description=homelab status-daemon (publishes server-status to Adafruit IO)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ homelab_dir }}/status_daemon.py
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
