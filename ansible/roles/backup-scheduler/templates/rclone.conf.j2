[r2]
type = s3
provider = Cloudflare
access_key_id = {{ vault_r2_access_key_id }}
secret_access_key = {{ vault_r2_secret_access_key }}
endpoint = {{ r2_endpoint }}
# rclone's S3 backend tries a CreateBucket preflight check by default --
# an R2 API token correctly scoped to only read/write/list objects
# inside an already-existing bucket (not create new buckets) doesn't
# have permission for that call, so every upload fails with a 403
# Access Denied even though the actual object write would have worked.
# This skips that unnecessary check.
no_check_bucket = true
