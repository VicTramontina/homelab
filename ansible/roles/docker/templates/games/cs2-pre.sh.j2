#!/bin/bash
# Generated by Ansible (roles/docker/tasks/games/cs2.yml) from
# group_vars/gameserver/vars.yml -> cs2_addons -- do not edit by hand.
# Sourced by the joedwards32/cs2 entrypoint on every container start,
# after SteamCMD has updated the game and before the server launches.

CSGO="${STEAMAPPDIR}/game/csgo"
MARKERS="${CSGO}/addons/.homelab"
mkdir -p "${MARKERS}"

# Each SteamCMD update rewrites gameinfo.gi, dropping the Metamod entry.
if ! grep -q 'csgo/addons/metamod' "${CSGO}/gameinfo.gi"; then
    sed -i '0,/^\(\s*\)Game\s\+csgo\s*$/s//\1Game\tcsgo\/addons\/metamod\n&/' "${CSGO}/gameinfo.gi"
    echo "pre-hook: patched gameinfo.gi for Metamod"
fi

install_addon() {
    local name="$1" url="$2" subdir="$3" dest="$4"
    local marker="${MARKERS}/${name}-$(echo -n "${url}" | md5sum | cut -c1-12)"
    [[ -f "${marker}" ]] && return 0
    echo "pre-hook: installing ${name}"
    local tmp file
    tmp="$(mktemp -d)"
    file="${tmp}/archive"
    if ! wget -qO "${file}" "${url}"; then
        echo "pre-hook: download failed for ${name}, skipping"
        rm -rf "${tmp}"
        return 0
    fi
    case "${url}" in
        *.json)
            mkdir -p "$(dirname "${CSGO}/${dest}")"
            cp "${file}" "${CSGO}/${dest}"
            ;;
        *)
            mkdir -p "${tmp}/x" "${CSGO}/${dest}"
            case "${url}" in
                *.zip) unzip -o -q "${file}" -d "${tmp}/x" ;;
                *) tar xzf "${file}" -C "${tmp}/x" ;;
            esac
            chmod -R u+rwX "${tmp}"
            cp -a "${tmp}/x/${subdir}/." "${CSGO}/${dest}/"
            ;;
    esac
    touch "${marker}"
    rm -rf "${tmp}"
}

{% for addon in cs2_addons %}
install_addon {{ addon.name | quote }} {{ addon.url | quote }} {{ addon.subdir | default('.') | quote }} {{ addon.dest | default('.') | quote }}
{% endfor %}

# CounterStrikeSharp on/off switch (cs2_css_enabled): Metamod only loads
# plugins that have a .vdf, so toggling is a rename and survives restarts.
VDF="${CSGO}/addons/metamod/counterstrikesharp.vdf"
{% if cs2_css_enabled %}
[[ -f "${VDF}.disabled" ]] && mv "${VDF}.disabled" "${VDF}" && echo "pre-hook: CounterStrikeSharp enabled"
{% else %}
[[ -f "${VDF}" ]] && mv "${VDF}" "${VDF}.disabled" && echo "pre-hook: CounterStrikeSharp disabled (cs2_css_enabled: false)"
{% endif %}

# Plugins listed in cs2_disabled_plugins stay installed but out of CSS's way.
PLUGINS="${CSGO}/addons/counterstrikesharp/plugins"
DISABLED_PLUGINS=({% for name in cs2_disabled_plugins %}{{ name | quote }} {% endfor %})
if [[ -d "${PLUGINS}" ]]; then
    mkdir -p "${PLUGINS}/disabled"
    for name in "${DISABLED_PLUGINS[@]}"; do
        if [[ -d "${PLUGINS}/${name}" ]]; then
            rm -rf "${PLUGINS}/disabled/${name}"
            mv "${PLUGINS}/${name}" "${PLUGINS}/disabled/${name}"
            echo "pre-hook: plugin ${name} disabled"
        fi
    done
    for dir in "${PLUGINS}"/disabled/*/; do
        [[ -d "${dir}" ]] || continue
        name="$(basename "${dir}")"
        [[ " ${DISABLED_PLUGINS[*]} " == *" ${name} "* ]] && continue
        rm -rf "${PLUGINS:?}/${name}"
        mv "${dir%/}" "${PLUGINS}/${name}"
        echo "pre-hook: plugin ${name} enabled"
    done
fi

# Some archives ship read-only directories, which would block later installs.
chmod -R u+rwX "${CSGO}/addons"

# Config managed by Ansible (mode and per-map cfgs, plugin configs), staged in
# homelab-overlay/ (mirrors game/csgo) and applied after every addon so it wins
# over the example files addons ship.
rm -f "${CSGO}"/cfg/Map-Configs-GoldKingZ/{aim_,de_,de_dust2}.cfg
if [[ -d "${STEAMAPPDIR}/homelab-overlay" ]]; then
    cp -a "${STEAMAPPDIR}/homelab-overlay/." "${CSGO}/"
fi
if [[ -f "${CSGO}/cfg/SharpTimer/example.config.cfg" && ! -f "${CSGO}/cfg/SharpTimer/config.cfg" ]]; then
    cp "${CSGO}/cfg/SharpTimer/example.config.cfg" "${CSGO}/cfg/SharpTimer/config.cfg"
fi

# The image's glibc refuses to dlopen shared objects that request an
# executable stack (CounterStrikeSharp's native library does): clear the
# flag on every addon .so. Idempotent, and cheap enough to run every start.
python3 - "${CSGO}/addons" <<'PY'
import struct, sys
from pathlib import Path

PT_GNU_STACK, PF_X = 0x6474E551, 0x1
for so in Path(sys.argv[1]).rglob("*.so"):
    with open(so, "r+b") as f:
        head = f.read(64)
        if head[:4] != b"\x7fELF" or head[4] != 2:
            continue
        phoff, = struct.unpack_from("<Q", head, 32)
        phentsize, phnum = struct.unpack_from("<HH", head, 54)
        for i in range(phnum):
            off = phoff + i * phentsize
            f.seek(off)
            p_type, p_flags = struct.unpack("<II", f.read(8))
            if p_type == PT_GNU_STACK and p_flags & PF_X:
                f.seek(off + 4)
                f.write(struct.pack("<I", p_flags & ~PF_X))
                print(f"pre-hook: cleared exec-stack flag on {so.name}")
PY
