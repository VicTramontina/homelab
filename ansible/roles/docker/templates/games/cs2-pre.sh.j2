#!/bin/bash
# Generated by Ansible (roles/docker/tasks/games/cs2.yml) from
# group_vars/gameserver/vars.yml -> cs2_addons -- do not edit by hand.
# Sourced by the joedwards32/cs2 entrypoint on every container start,
# after SteamCMD has updated the game and before the server launches.

CSGO="${STEAMAPPDIR}/game/csgo"
MARKERS="${CSGO}/addons/.homelab"
mkdir -p "${MARKERS}"

# Each SteamCMD update rewrites gameinfo.gi, dropping the Metamod entry.
if ! grep -q 'csgo/addons/metamod' "${CSGO}/gameinfo.gi"; then
    sed -i '0,/^\(\s*\)Game\s\+csgo\s*$/s//\1Game\tcsgo\/addons\/metamod\n&/' "${CSGO}/gameinfo.gi"
    echo "pre-hook: patched gameinfo.gi for Metamod"
fi

install_addon() {
    local name="$1" url="$2" subdir="$3" dest="$4"
    local marker="${MARKERS}/${name}-$(echo -n "${url}" | md5sum | cut -c1-12)"
    [[ -f "${marker}" ]] && return 0
    echo "pre-hook: installing ${name}"
    local tmp file
    tmp="$(mktemp -d)"
    file="${tmp}/archive"
    if ! wget -qO "${file}" "${url}"; then
        echo "pre-hook: download failed for ${name}, skipping"
        rm -rf "${tmp}"
        return 0
    fi
    mkdir -p "${tmp}/x"
    case "${url}" in
        *.zip) unzip -o -q "${file}" -d "${tmp}/x" ;;
        *) tar xzf "${file}" -C "${tmp}/x" ;;
    esac
    mkdir -p "${CSGO}/${dest}"
    cp -a "${tmp}/x/${subdir}/." "${CSGO}/${dest}/"
    touch "${marker}"
    rm -rf "${tmp}"
}

{% for addon in cs2_addons %}
install_addon {{ addon.name | quote }} {{ addon.url | quote }} {{ addon.subdir | default('.') | quote }} {{ addon.dest | default('.') | quote }}
{% endfor %}

# The image's glibc refuses to dlopen shared objects that request an
# executable stack (CounterStrikeSharp's native library does): clear the
# flag on every addon .so. Idempotent, and cheap enough to run every start.
python3 - "${CSGO}/addons" <<'PY'
import struct, sys
from pathlib import Path

PT_GNU_STACK, PF_X = 0x6474E551, 0x1
for so in Path(sys.argv[1]).rglob("*.so"):
    with open(so, "r+b") as f:
        head = f.read(64)
        if head[:4] != b"\x7fELF" or head[4] != 2:
            continue
        phoff, = struct.unpack_from("<Q", head, 32)
        phentsize, phnum = struct.unpack_from("<HH", head, 54)
        for i in range(phnum):
            off = phoff + i * phentsize
            f.seek(off)
            p_type, p_flags = struct.unpack("<II", f.read(8))
            if p_type == PT_GNU_STACK and p_flags & PF_X:
                f.seek(off + 4)
                f.write(struct.pack("<I", p_flags & ~PF_X))
                print(f"pre-hook: cleared exec-stack flag on {so.name}")
PY
