#!/usr/bin/env python3
"""Switch the CS2 server between modes and maps over local RCON.

Generated by Ansible (roles/docker/tasks/games/cs2.yml).

    cs2-mode --list                 workshop maps by mode
    cs2-mode <map>                  a catalog map, e.g. surf_kitsune (mode inferred)
    cs2-mode <mode> [map]           mode (default, bhop, surf, arena), optional map

[map] is a catalog name, a numeric Steam Workshop id or a stock map name
(de_dust2). Without a map, only the settings change and fully apply on the
next map load.
"""
import json
import sys
import time

sys.path.insert(0, "{{ homelab_dir }}")
from rcon_client import RconClient, RconError  # noqa: E402

MODES_DIR = "homelab/modes"
CATALOG = json.loads({{ cs2_maps | to_json | tojson }})
LOAD_WAIT = object()
# The engine restores the cvars saved before a workshop map when leaving it and
# re-runs gamemode_*.cfg on every load, so the mode is applied again once the
# new map is up. Workshop maps can take longer while they download.
LOAD_WAIT_SECONDS = 25


def main() -> int:
    args = sys.argv[1:]
    if args == ["--list"]:
        for mode, maps in CATALOG.items():
            print(f"{mode}:")
            for name, workshop_id in maps.items():
                print(f"  {name}  ({workshop_id})")
        return 0
    if len(args) not in (1, 2):
        print(__doc__)
        return 2

    modes = ["default", *CATALOG]
    by_name = {name: (mode, wid) for mode, maps in CATALOG.items() for name, wid in maps.items()}
    if args[0] in modes:
        mode = args[0]
        target = args[1] if len(args) == 2 else None
    elif args[0] in by_name and len(args) == 1:
        mode, target = args[0], args[0]
    else:
        print(f"Unknown mode or map: {args[0]}\n")
        print(__doc__)
        return 2
    if target in by_name:
        target = by_name[target][1]

    with open("{{ homelab_dir }}/config.json") as f:
        game = json.load(f)["games"]["{{ game_name }}"]

    mode_commands = [f"exec {MODES_DIR}/default"]
    if mode != "default":
        mode_commands.append(f"exec {MODES_DIR}/{mode}")

    steps = list(mode_commands)
    if target:
        steps.append(f"host_workshop_map {target}" if target.isdigit() else f"changelevel {target}")
        steps.append(LOAD_WAIT)
        steps.extend(mode_commands)

    for step in steps:
        if step is LOAD_WAIT:
            time.sleep(LOAD_WAIT_SECONDS)
            continue
        if not run(game, step):
            return 1
    return 0


def run(game: dict, command: str) -> bool:
    for _ in range(2):
        try:
            with RconClient(game["rcon_host"], game["rcon_port"], game["rcon_pass"]) as client:
                reply = client.command(command)
            break
        except (RconError, OSError):
            time.sleep(1)
    else:
        print(f"RCON failed on: {command}")
        return False
    print(f"> {command}")
    if "Unknown command" in reply:
        print(reply)
        return False
    return True


if __name__ == "__main__":
    sys.exit(main())
