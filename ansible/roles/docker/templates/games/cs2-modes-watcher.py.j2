#!/usr/bin/env python3
"""Re-apply the CS2 mode cfg after every map load.

Generated by Ansible (roles/docker/tasks/games/cs2.yml).

Plugins that only make sense in one mode (K4-Arenas) are loaded and unloaded
here too: they need a map that is already loaded, which Map-Configs cannot
give them because it runs before the map exists.

The engine resets the game-rules cvars (autobhop, damage scale, round rules)
on every level load, after Map-Configs-GoldKingZ has already applied the mode,
and Workshop maps also run their own cfg. Only an exec after the load sticks,
so this polls the map over local RCON and runs it once the load has settled.
"""
import json
import re
import sys
import time

sys.path.insert(0, "{{ homelab_dir }}")
from rcon_client import RconClient, RconError  # noqa: E402

PREFIXES = json.loads({{ cs2_mode_prefixes | to_json | tojson }})
MODE_PLUGINS = json.loads({{ cs2_mode_plugins | to_json | tojson }})
MANAGED_PLUGINS = sorted({name for names in MODE_PLUGINS.values() for name in names})
MODES_DIR = "homelab/modes"
POLL_SECONDS = 5
SETTLE_SECONDS = 20
MAP_RE = re.compile(r"\[1: ([^ |]+) \| main lump")
SPAWN_RE = re.compile(r"^spawn\s*:\s*(\d+)", re.MULTILINE)


def rcon(game: dict, command: str) -> str:
    with RconClient(game["rcon_host"], game["rcon_port"], game["rcon_pass"]) as client:
        return client.command(command)


def level_key(game: dict):
    try:
        status = rcon(game, "status")
    except (RconError, OSError):
        return None
    loaded = MAP_RE.search(status)
    spawn = SPAWN_RE.search(status)
    if not loaded:
        return None
    return loaded.group(1), spawn.group(1) if spawn else ""


def mode_for(map_name: str):
    for prefix, mode in PREFIXES.items():
        if map_name.startswith(prefix):
            return mode
    return None


def main() -> None:
    with open("{{ homelab_dir }}/config.json") as f:
        game = json.load(f)["games"]["{{ game_name }}"]

    applied = None
    while True:
        key = level_key(game)
        if key and key != applied:
            time.sleep(SETTLE_SECONDS)
            if level_key(game) == key:
                mode = mode_for(key[0])
                if mode:
                    try:
                        rcon(game, f"exec {MODES_DIR}/{mode}")
                        for plugin in MANAGED_PLUGINS:
                            wanted = plugin in MODE_PLUGINS.get(mode, [])
                            rcon(game, f"gkz_{'load' if wanted else 'unload'} {plugin}")
                        print(f"cs2-modes: {key[0]} -> {mode}", flush=True)
                    except (RconError, OSError) as exc:
                        print(f"cs2-modes: exec failed for {key[0]}: {exc}", flush=True)
                        continue
                applied = key
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
