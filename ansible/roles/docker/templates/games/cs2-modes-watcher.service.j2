[Unit]
Description=homelab cs2-modes (re-applies the game mode cfg after each CS2 map load)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ homelab_dir }}/cs2_modes_watcher.py
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
