# Template for the encrypted secrets file. DO NOT put real values here --
# this file is committed as documentation of which keys are expected.
#
# Create the real file locally with:
#   ansible-vault create ansible/group_vars/gameserver/vault.yml
# (it is gitignored, so it never gets committed)
#
# Then paste in real values following this same structure, and run the
# playbook with --ask-vault-pass or a --vault-password-file.

vault_aio_key: "changeme-adafruit-io-key"

# One vault_rcon_pass_<game> variable per entry in group_vars/gameserver/vars.yml -> games
# (RCON is admin-only, used by our own daemons -- not what players type to join)
vault_rcon_pass_humanityz: "changeme-rcon-password"
vault_rcon_pass_cs2: "changeme-rcon-password"

# One vault_join_pass_<game> variable per entry in vars.yml -> games -- this
# IS what players type in-game to connect. Optional in principle, but the
# server has no port forwarding to begin with, so treat it as a basic filter
# against randoms who stumble onto the playit.gg address, not real security.
vault_join_pass_humanityz: "changeme-join-password"
vault_join_pass_cs2: "changeme-join-password"

# CS2's Steam Game Server Login Token (GSLT) -- get one from
# https://steamcommunity.com/dev/managegameservers ("any IP" is fine since
# the playit.gg address isn't known in advance). Required for the server
# to be VAC-secure and show up in the server browser; friends who already
# know the playit.gg address can still direct-connect without one, so
# leave this unset if you don't want to register a token.
vault_gslt_cs2: "changeme-gslt-token"

# Cloudflare R2 (S3-compatible) credentials for the backup-scheduler role
vault_r2_access_key_id: "changeme-r2-access-key-id"
vault_r2_secret_access_key: "changeme-r2-secret-access-key"

# playit.gg agent secret key (playit-agent role) -- lets friends join
# without VPN or router port forwarding. Get it from playit.gg: create an
# account, create an agent (any type, e.g. "Docker"), and copy its Secret
# Key from https://playit.gg/account/agents -- no need to actually run
# Docker, the key works the same for the native Linux agent.
vault_playit_secret_key: "changeme-playit-secret-key"

# Discord channel webhook URL: game-manager posts state-change
# notifications here (game started/stopped/backed up, PC shutting down),
# for both manual commands and automatic idle-triggered actions. Optional:
# leave unset (or don't set this key at all) to skip notifications
# entirely. Create one via Discord: Channel Settings -> Integrations ->
# Webhooks -> New Webhook -> Copy Webhook URL.
vault_discord_webhook_url: "changeme-discord-webhook-url"
