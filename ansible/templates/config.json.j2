{
  "aio_username": "{{ aio_username }}",
  "aio_key": "{{ vault_aio_key }}",
  "homelab_dir": "{{ homelab_dir }}",
  "compose_dir": "{{ homelab_dir }}/server",
  "r2_bucket": "{{ r2_bucket }}",
  "backups_to_keep": {{ backups_to_keep }},
  "discord_webhook_url": "{{ vault_discord_webhook_url | default('') }}",
  "games": {
{% for name, game in games.items() %}
    "{{ name }}": {
      "label": "{{ game.label | default(name) }}",
      "game_type": "{{ game.game_type }}",
      "compose_service": "{{ game.compose_service }}",
      "rcon_host": "{{ game.rcon_host | default('') }}",
      "rcon_port": {{ game.rcon_port | default(0) }},
      "rcon_pass": "{{ vars['vault_rcon_pass_' + name] | default('') }}",
      "max_players": {{ game.max_players }},
      "volume_path": "{{ game.volume_path }}",
      "backup": {{ (game.backup | default(true)) | lower }},
      "companion_services": {{ game.companion_services | default([]) | to_json }}
    }{% if not loop.last %},{% endif %}

{% endfor %}
  }
}
